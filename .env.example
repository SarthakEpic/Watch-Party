# Optional: use OMDb for movie posters, metadata, and IMDb ratings.
# Get a free API key at https://www.omdbapi.com/apikey.aspx
# Keep the real key in .env; never put it in browser JavaScript or commit it.
OMDB_API_KEY=

# Optional: live, searchable stickers from KLIPY.
# The app displays KLIPY attribution and loads sticker media directly from KLIPY.
# Create an app key at https://partner.klipy.com/ and add it to your private .env
# file or hosting provider's environment settings.
KLIPY_APP_KEY=

# Optional: share room snapshots, WebSocket events, and peer signaling
# between multiple Uvicorn workers on one machine. For Upstash, copy the TLS
# connection string (it normally starts with rediss://).
# REDIS_URL=rediss://default:password@your-database.upstash.io:6379

# Optional: coturn relay for restrictive NATs and firewalls.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=use-the-same-long-random-secret-as-coturn

# Optional: LiveKit Cloud SFU for camera/screen-share calls. LiveKit Cloud
# provides managed TURN, so a separate coturn server is not needed in this mode.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=server-side-key
# LIVEKIT_API_SECRET=server-side-secret

# Optional: private S3-compatible storage for uploaded clips.
# Example Cloudflare R2 values: region=auto and endpoint URL uses your account ID.
# MEDIA_STORAGE=s3
# S3_BUCKET=your-private-bucket
# S3_REGION=auto
# S3_PREFIX=watchparty-media
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Cloudflare R2 S3 API credentials. Keep these server-side in .env.
# S3_ACCESS_KEY_ID=your-r2-access-key-id
# S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
